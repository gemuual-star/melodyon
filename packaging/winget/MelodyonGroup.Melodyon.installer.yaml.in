# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.28.0.schema.json
PackageIdentifier: MelodyonGroup.Melodyon
PackageVersion: '@VERSION@'
InstallerType: exe
Scope: user
InstallModes:
  - interactive
  - silent
InstallerSwitches:
  Silent: --silent
  SilentWithProgress: --silent
  Custom: --launch=false
UpgradeBehavior: install
Protocols:
  - melodyon
AppsAndFeaturesEntries:
  - DisplayName: Melodyon Desktop
    Publisher: MelodyonGroup
    ProductCode: Melodyon
Installers:
  - Architecture: x64
    InstallerUrl: '@WINDOWS_URL@'
    InstallerSha256: '@WINDOWS_SHA256@'
ManifestType: installer
ManifestVersion: 1.28.0
